# OpenAI API key (required for real GPT-4.1 mini answers).
# Leave empty to run in demo mode (retrieval + structured placeholder answers).
OPENAI_API_KEY=

# OpenAI model
OPENAI_MODEL=gpt-4.1-mini

# Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis (only needed when SYNC_JOBS=false)
REDIS_URL=redis://localhost:6379/0

# true  = easiest local mode (no Celery worker needed)  ← recommended on Windows
# false = use Celery + Redis
SYNC_JOBS=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Upload folder
UPLOAD_DIR=uploads

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval (higher recall → better accuracy)
RETRIEVE_K=10
TOP_K=6
MIN_RERANK_SCORE=0.0
MIN_KEEP_HITS=3
MAX_CORRECTION_LOOPS=3
